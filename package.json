{
  "name": "clean-code-todo",
  "version": "1.0.0",
  "private": true,
  "description": "A small TODO app for the RS School Clean Code task",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "*.js": [
      "eslint --no-fix"
    ],
    "*.{html,css,js,json,md}": [
      "prettier --check"
    ]
  }
}
